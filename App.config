<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Modbus.Host" value="127.0.0.1" />
    <add key="Modbus.Port" value="502" />
    <add key="Modbus.SlaveId" value="1" />
    <add key="Modbus.StartAddress" value="0" />
    <add key="Modbus.NumRegisters" value="10" />
    <add key="Modbus.RegisterType" value="Holding" />

    <add key="Polling.IntervalMs" value="1000" />
    <add key="Device.Id" value="PLC-01" />

    <!-- Cate puncte sa pastreze graficul pe fiecare serie -->
    <add key="Chart.MaxPoints" value="60" />
	<add key="Register.Aliases" value="Temperatura,Presiune,Umiditate,Nivel rezervor,Debit,Tensiune,Curent,RPM Motor,Vibratie,Temp ulei" />
  </appSettings>

  <connectionStrings>
    <add name="ModbusDb" connectionString="Data Source=modbus.db;" providerName="Microsoft.Data.Sqlite" />
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="SQLitePCLRaw.core" publicKeyToken="1488e028ca7ab535" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.1.12.3116" newVersion="2.1.12.3116" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
